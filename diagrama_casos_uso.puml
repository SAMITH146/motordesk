@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

' Estilos visuales del diagrama
skinparam rectangle {
    BackgroundColor #1e293b
    BorderColor #3b82f6
    FontColor #f8fafc
}
skinparam usecase {
    BackgroundColor #0f172a
    BorderColor #60a5fa
    FontColor #f8fafc
    ArrowColor #94a3b8
}
skinparam actor {
    BackgroundColor #3b82f6
    BorderColor #2563eb
    FontColor #ffffff
}

actor "Administrador" as Admin
actor "Mecánico" as Mecanico

rectangle "MotorDesk - Sistema de Gestión de Taller" {
    
    ' Autenticación (Común)
    usecase "Autenticarse por PIN\n(Acceso al Sistema)" as UC_Login
    
    ' Flujo del Mecánico
    usecase "Crear Orden de Trabajo\n(Descripción y Repuestos)" as UC_CrearOrden
    usecase "Registrar/Actualizar Cliente y Vehículo\n(Durante apertura de orden)" as UC_RegCliVeh
    usecase "Actualizar Estado de Orden\n(Abierta/Proceso/Espera/Terminado)" as UC_ActEstMec
    usecase "Consultar Disponibilidad\nde Inventario" as UC_ConsInv
    
    ' Flujo del Administrador
    usecase "Gestionar Mecánicos\n(CRUD y Asignación de PIN)" as UC_GestMec
    usecase "Gestionar Clientes\n(Visualizar y Editar datos)" as UC_GestCli
    usecase "Gestionar Catálogo de Repuestos\n(CRUD y Precios)" as UC_GestRep
    usecase "Registrar Compra de Repuestos\n(Aumenta stock)" as UC_RegCompra
    usecase "Consultar Historial de Compras" as UC_HistCompras
    usecase "Gestionar Todas las Órdenes\n(Control de Estados y Motivos)" as UC_SupOrdenes
    usecase "Registrar Pago y Facturar\n(Imprimir Factura PDF)" as UC_Facturar
    usecase "Visualizar Alertas\nde Stock Crítico" as UC_AlertasStock

    ' Conexiones de Autenticación
    Admin --> UC_Login
    Mecanico --> UC_Login

    ' Conexiones del Mecánico
    Mecanico --> UC_CrearOrden
    Mecanico --> UC_ActEstMec
    Mecanico --> UC_ConsInv
    
    ' Conexiones del Administrador
    Admin --> UC_GestMec
    Admin --> UC_GestCli
    Admin --> UC_GestRep
    Admin --> UC_RegCompra
    Admin --> UC_HistCompras
    Admin --> UC_SupOrdenes
    Admin --> UC_Facturar
    Admin --> UC_AlertasStock

    ' Relaciones entre Casos de Uso
    UC_CrearOrden ..> UC_RegCliVeh : <<include>>
    UC_Facturar ..> UC_SupOrdenes : <<extend>>
}
@enduml
